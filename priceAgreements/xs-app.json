{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "/v4/(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/v2/(.*)$",
      "target": "/v2/$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "^/debug(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "localDir": "webapp/"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "authenticationType": "xsuaa",
      "localDir": "dist/"
    }
  ]
}
