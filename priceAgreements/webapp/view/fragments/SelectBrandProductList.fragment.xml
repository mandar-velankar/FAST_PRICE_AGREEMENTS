<!-- Fragment for Add product - Master Page -->
<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:l="sap.ui.layout" 
	xmlns:form="sap.ui.layout.form" 
	xmlns:core="sap.ui.core"
	xmlns:dnd="sap.ui.core.dnd">
	
			<VBox id="idProductSelectionLists" fitContainer="true" alignItems="Stretch" height="100%" >
				<items>
					
										
					<!-- Select brand -->
					<MultiInput id="idBrandList" width="50%" enabled="true" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="brandNameList_f4" value="" placeholder="Select  brand" tokenUpdate="onBrandTokenChange"/>
					
					
				
					<!-- Source & Target table next to each other -->
					<HBox width="100%" height="100%" fitContainer="false">
						<items>
							<!-- Source -->
							<VBox width="50%" height="100%" fitContainer="false">
								<items>									
									<!-- Input list -->
									<ScrollContainer
										id="idListProductsInputContainer"
										height="100%" 
										width="100%"
										vertical="true"
										focusable="true">
										<Table
											id="idListProductsInput"
											mode="MultiSelect"
											items="{
												path: 'pa>/ProductCollection',
												sorter: {
												path: 'ProductName',
												descending: false
													}
											}"
											selectionChange="onSelectionChangeProductListInput"
											includeItemInSelection="true"
											growing="true"
											growingThreshold="100"
											 >
											
											<headerToolbar>
												<OverflowToolbar >
												<SearchField liveChange=".onSearchProductsInput" width="90%" />
												</OverflowToolbar>
											</headerToolbar>
											<infoToolbar>
												<OverflowToolbar visible="false" id="idInfoToolbarInput">
													<Label id="idFilterLabelInput" />
												</OverflowToolbar>
											</infoToolbar>
											<columns>
												<Column>
													<Text text="Products" />
												</Column>
											</columns>
											<items>
												<ColumnListItem>
													<cells>
														<VBox>
															<Text text="{pa>ProductName}" wrapping="false" />
															
														</VBox>
														
													</cells>
												</ColumnListItem>
											</items>
										</Table>
									</ScrollContainer>
								</items>
							</VBox>
							
							<!-- Add / Delete button -->
							<HBox alignItems="Center" justifyContent="Center">
								<items>									
									<!-- buttons -->
									<VBox alignItems="Center">
										<items>
											<Button icon="sap-icon://arrow-right" type="Transparent" press="onPressAddProductToOutputList" ariaLabelledBy="actionButtonLabel"/>
											<Button icon="sap-icon://arrow-left" type="Transparent" press="onPressRemoveProductFromOutputList" ariaLabelledBy="actionButtonLabel"/>
										</items>	
									</VBox>									
								</items>
							</HBox>

							<!-- Target -->
							<VBox width="50%">
								<items>
									
									
									<ScrollContainer
										id="idListProductsOutputContainer"
										width="100%"
										height="100%"
										vertical="true"
										focusable="true">
										<!--Output list -->
										<Table
											id="idListProductsOutput"
											mode="SingleSelectMaster" 
											items="{
												path: 'pa>/products'
										
											}">
											
											<headerToolbar>
												<OverflowToolbar visible="false" id="idInfoToolbarOutput" >
													<Label id="idFilterLabelOutput" />
													<ToolbarSpacer/>
													<Button
														icon="sap-icon://navigation-up-arrow"
														tooltip="Move up"
														press="moveUp"/>
													<Button
														icon="sap-icon://navigation-down-arrow"
														tooltip="Move down"
														press="moveDown"/>				
												</OverflowToolbar>
											</headerToolbar>
											<columns>
												<Column>
													<Text text="Products" />
												</Column>
											</columns>
											<items>
												<ColumnListItem>
													<cells>
														<VBox>
															<Text text="{pa>ProductName}" wrapping="false" />
															
														</VBox>
														
													</cells>
												</ColumnListItem>
											</items>
										</Table>
									</ScrollContainer>
								</items>
							</VBox>												
							
						
						</items>
					</HBox>
				</items>
			</VBox>
			
	
	
</core:FragmentDefinition>