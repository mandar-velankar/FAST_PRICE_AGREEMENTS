<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog showHeader="false">
		<content>			
			<Table items="{sc>/settlementDates}">
				<headerToolbar>
					<OverflowToolbar id="otbSubheader">
						<Title text="Settlement calendar" level="H2" />
						<ToolbarSpacer />
						<Button icon="sap-icon://add" type="Transparent" press=".onAdd" visible="{= ${pa>/editMode} &amp;&amp; !${pa>/priceAgreement/synchronized} }"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column>
						<Text text="From" />
					</Column>
					<Column>
						<Text text="To" />
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
                            <DatePicker value="{
                                                path:'sc>fromDate',
                                                type:'sap.ui.model.type.Date', 
                                                formatOptions: { style: 'short', pattern: 'yyyy-MM-dd'}
                                        }"
										minDate="{sc>minDate}"
										maxDate="{sc>maxDate}"
                                        valueFormat="yyyy-MM-dd" 
                                        displayFormat="short"
										change=".onChangeSettlementDate"
                                        enabled="{= ${pa>/editMode} &amp;&amp; !${pa>/priceAgreement/synchronized} }"/>
                            <DatePicker value="{
                                                path:'sc>toDate',
                                                type:'sap.ui.model.type.Date', 
                                                formatOptions: { style: 'short', pattern: 'yyyy-MM-dd'}
                                        }"
										minDate="{sc>minDate}"
										maxDate="{sc>maxDate}"
                                        valueFormat="yyyy-MM-dd" 
                                        displayFormat="short"
										change=".onChangeSettlementDate"
                                        enabled="{= ${pa>/editMode} &amp;&amp; !${pa>/priceAgreement/synchronized} }"/>
                        </cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<buttons>
			<Button text="Apply" press=".onApply" visible="{= ${pa>/editMode} &amp;&amp; !${pa>/priceAgreement/synchronized} }"></Button>
			<Button icon="sap-icon://decline" text="Cancel" press=".onClose"></Button>
		</buttons>
	</Dialog>
</core:FragmentDefinition>