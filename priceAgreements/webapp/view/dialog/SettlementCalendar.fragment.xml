<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog showHeader="false">
		<content>			
			<Table items="{sc>/settlementDates}" sticky="ColumnHeaders,HeaderToolbar">
				<headerToolbar>
					<OverflowToolbar id="otbSubheader">
						<Title text="Settlement calendar" level="H2" />
						<ToolbarSpacer />
						<Button icon="sap-icon://add" type="Transparent" press=".onAdd" visible="{= ${pa>/editMode} &amp;&amp; !${pa>/priceAgreement/synchronized} }"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column>
						<Text text="{i18n>from}" />
					</Column>
					<Column>
						<Text text="{i18n>to}" />
					</Column>
					<Column>
						<Text text="{i18n>delete}" />
					</Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
                            <DatePicker value="{
                                                path:'sc>fromDate',
                                                type:'sap.ui.model.type.Date', 
                                                formatOptions: { style: 'short', pattern: 'yyyy-MM-dd',UTC: true}
                                        }"
										minDate="{sc>minDate}"
										maxDate="{= ${sc>toDate} || ${sc>maxDate} }"
										valueState="{sc>fromValueState}"
                                        valueFormat="yyyy-MM-dd" 
                                        displayFormat="short"
										change=".onChangeSettlementDate($event,'from')"
                                        enabled="{= ${pa>/editMode} &amp;&amp; !${pa>/priceAgreement/synchronized} }"/>
                            <DatePicker value="{
                                                path:'sc>toDate',
                                                type:'sap.ui.model.type.Date', 
                                                formatOptions: { style: 'short', pattern: 'yyyy-MM-dd',UTC: true}
                                        }"
										minDate="{= ${sc>fromDate} || ${sc>minDate}}"
										maxDate="{sc>maxDate}"
										valueState="{sc>toValueState}"
                                        valueFormat="yyyy-MM-dd" 
                                        displayFormat="short"
										change=".onChangeSettlementDate($event,'to')"
                                        enabled="{= ${pa>/editMode} &amp;&amp; !${pa>/priceAgreement/synchronized} }"/>
							<Button icon="sap-icon://delete" press=".onDeleteRange"/>
                        </cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<buttons>
			<Button text="Apply" 
				press=".onApply" 
				enabled="{sc>/valid}"
				visible="{= ${pa>/editMode} &amp;&amp; !${pa>/priceAgreement/synchronized} }"></Button>
			<Button icon="sap-icon://decline" text="Cancel" press=".onClose"></Button>
		</buttons>
	</Dialog>
</core:FragmentDefinition>