<mvc:View controllerName="com.bayer.tender.priceagreements.controller.DetailDetail"
	xmlns="sap.f"
	xmlns:m="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:form="sap.ui.layout.form"
	xmlns:layout="sap.ui.layout"
	xmlns:core="sap.ui.core">
	<DynamicPage id="idDynamicPage" toggleHeaderOnTitleClick="false">
		<title>
			<DynamicPageTitle>
				<heading>
					<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Center">
						<m:Title text="text" wrapping="true" class="sapUiTinyMarginEnd"/>
					</m:FlexBox>
				</heading>

				<!-- ACTIONS -->
				<actions>
					<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditModePress" enabled="{= ${soa>/editMode} === false ? true : false }"/>
				</actions>

				<navigationActions>
					<m:OverflowToolbarButton type="Transparent" icon="sap-icon://full-screen" press=".handleFullScreen" tooltip="Enter Full Screen Mode" visible="{= !${detailDetailView>/actionButtonsInfo/fullScreen}}"/>
					<m:OverflowToolbarButton type="Transparent" icon="sap-icon://exit-full-screen" press=".handleExitFullScreen" tooltip="Exit Full Screen Mode" visible="{= ${detailDetailView>/actionButtonsInfo/fullScreen}}"/>
					<m:OverflowToolbarButton type="Transparent" icon="sap-icon://decline" press=".handleClose" tooltip="Close column" visible="{= ${detailDetailView>/actionButtonsInfo/endColumn/closeColumn} !== null }"/>
				</navigationActions>
			</DynamicPageTitle>
		</title>

		

		<content>
			
		</content>
		
	</DynamicPage>
</mvc:View>