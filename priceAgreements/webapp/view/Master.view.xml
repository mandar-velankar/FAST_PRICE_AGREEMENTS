<mvc:View
	controllerName="com.bayer.tender.priceagreements.controller.Master"
	xmlns="sap.m"
	xmlns:semantic="sap.f.semantic"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

	<f:DynamicPage id="dynamicPageId" toggleHeaderOnTitleClick="false">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Price Agreements (n)"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<!-- DynamicPage Content -->
		<f:content>
			<VBox fitContainer="true">
				<OverflowToolbar class="sapFDynamicPageAlignContent">
					<Select	id="idslctfilter">
						<core:Item key="" text=""/>
						<core:Item key="New Agreements" text="New Agreements"/>
						<core:Item key="New Material Numbers" text="New Material Numbers"/>
						<core:Item key="Updated Retail Price" text="Updated Retail Price"/>
						<core:Item key="Expiring Soon" text="Expiring Soon"/>
						<core:Item key="Expired" text="Expired"/>
					</Select>
					<ToolbarSpacer/>				
						<SearchField id="idSearch" search=".setFilter" width="17.5rem"/>
						<Button icon="sap-icon://filter" text="" press=".onOpenViewSettings"/>
				</OverflowToolbar>
				<Table
						id="list"
						inset="false"
						items="{
							path: '/PriceAgreements',
							sorter: {
								path: 'ID',
								descending: false
							},
							parameters: {
								expand: 'Candidates,Product,Tender,Institute'
							}
						}"
						class="sapFDynamicPageAlignContent"
						width="auto"
						updateFinished=".onUpdateFinished"
						alternateRowColors="true"
						contextualWidth="Auto" 
						popinLayout="Block"
						growing="true"
						growingThreshold="15"
						growingScrollToLoad="false">
					<columns>
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>Reference}" />
							</header>
						</Column>
						<Column visible="true">
							<header>
								<ObjectIdentifier title="{i18n>Product}" />
							</header>
						</Column>
						<Column visible="true">
							<header>
								<ObjectIdentifier title="{i18n>Price}" />
							</header>
						</Column>
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>EffectiveDate}" />
							</header>
						</Column>
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>ExpiryDate}" />
							</header>
						</Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onSelectionChange" highlight="Error" id="items">
							<cells>
								<Text text="IT-21-1001-1"/>
								<Text text="XARELTO 20mg 28 TABL"/>
								<Text text="{Price}"/>
								<Text text="{
										path: 'EffectiveDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
								<Text text="{
										path: 'ExpiryDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>