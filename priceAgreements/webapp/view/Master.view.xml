<mvc:View
	controllerName="com.bayer.tender.priceagreements.controller.Master"
	xmlns="sap.m"
	xmlns:semantic="sap.f.semantic"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

	<f:DynamicPage id="dynamicPageId" toggleHeaderOnTitleClick="false">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Price Agreements"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<!-- DynamicPage Content -->
		<f:content>
			<VBox fitContainer="true">
				<OverflowToolbar class="sapFDynamicPageAlignContent">
                    <Select id="idSlctCountry"  
                            items="{ 
								path: '/UserCountry', 
								sorter: { path: 'Country/CountryName' }, 
								parameters: { expand: 'Country' },
								events: {
									dataReceived: '.onUserCountriesReceived'
								}
                            }"
							change=".onChangeCountryFilter"
							visible="{= ${appView>/layout} === 'OneColumn' }"
                            forceSelection="true"
							selectedKey="{pa>/selectedCountryFilter}">
							<core:Item key="{CountryCode}" text="{Country/CountryName}"/>
					</Select>
					<Select	id="idslctfilter" change=".setFilter" items="{pa>/countryFilters}">
						<core:Item key="{pa>key}" text="{pa>value}"/>
					</Select>

					<Label text="{i18n>Product}" visible="{= ${appView>/layout} === 'OneColumn' }"/>

              <!-- EHQUT-Price agreement app - Product multiple selection limited -->      

					<Select  
						id="idProductPackfilter"
						change=".setFilter" 
						items="{ 
							path: '/PriceAgreementProductNames',
							events: {
								dataReceived: '.onProductPackIdsReceived'
							},
                            sorter: {
                                path: 'ProductName'         
                            }
						}">
						<core:Item key="{ProductPackId}" text="{ProductName}" />
					</Select>
					<!-- EHQUT-383702-Spain - search Division filter -->
					<Select id="idDivisionES" enabled="true" visible="{= ${pa>/selectedCountryFilter} === 'ES'}" change=".setFilter">
                                    <items>
                                        <core:Item text="All" key="All"/>
                                        <core:Item text="Pharma" key="Pharma"/>
                                        <core:Item text="Radiology" key="Radiology"/>
                                        <core:Item text="Consumer Health" key="Consumer Health"/>
                                    </items>
                        </Select>
					<!-- EHQUT-199066-Italy – Brand filter in Price Agreements -->
					<Button text="Brand Filter" icon="sap-icon://add" press="onAddProductForOffer" enabled="true" visible="{= ${pa>/selectedCountryFilter} === 'ES' ||  ${pa>/selectedCountryFilter} === 'IT'}"/>

                 <!-- EHQUT-Price agreement app - Product multiple selection limited --> 

					<ToolbarSpacer/>
						<Button
							id="idApplyNewPrice"
							text="Apply price"
							enabled="{masterView>/btnApplyNewPriceEnabled}"
							type="Emphasized"
							press=".onApplyNewPricePress"/>				
						<SearchField id="idSearch" search=".setFilter" width="17.5rem"/>
						<Button icon="sap-icon://sort" text="" press=".onOpenViewSettings"/>
				</OverflowToolbar>
                 <!-- EHQUT-123276-Price agreement app not loading --> 
				 <!-- EHQUT-199067-Italy – Price Agreements multiple selection --> 
				<Table
						id="list"
						inset="false"
						items="{
							path: '/PriceAgreementsMasterView',
							sorter: {
								path: 'ID',
								descending: false
							},
							parameters: {
								expand: 'Product/ProductPack,Tender,Tender/User,Institute,CustomerPrices,ConsumerPrice,FOC,Materials,OfferProduct/Offer,PriceConditions/PriceConditionClassification'
							}, 
							suspended : true
						}"
						class="sapFDynamicPageAlignContent"
						width="auto"
						updateFinished=".onUpdateFinished"
						alternateRowColors="true"
						contextualWidth="Auto" growing="true"
                        growingThreshold="15" 
                        growingScrollToLoad="false" mode="{= ${pa>/selectedCountryFilter} === 'IT' ? 'MultiSelect' : 'None'}"> 
                        <!-- !!!!!!!!!!!!THE GROWING THRESHOLD HAS BEEN SET TO 200, THIS CAN NOT BE MOVED TO PRODUCTION!!!!!!!!!!!! --> 
                        
                        <!-- EHQUT-123276-Price agreement app not loading --> 
					<columns>
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>TenderId}" />
							</header>
						</Column>
                        <!-- <Column>
							<header>
								<ObjectIdentifier title="{i18n>OfferID}" />
							</header>
						</Column> -->
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>UserName}" />
							</header>
						</Column>
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>Classification}" />
							</header>
						</Column>
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>Reference}" />
							</header>
						</Column>
                        <Column>
							<header>
								<ObjectIdentifier title="{i18n>MaterialNumber}" />
							</header>
						</Column>
                         <!-- EHQUT-175601-Customer Code added in price agreement -->
                        <Column>
							<header>
								<ObjectIdentifier title="{i18n>CustID}" />
							</header>
						</Column>
                        <Column>
							<header>
								<ObjectIdentifier title="{i18n>Division}" />
							</header>
						</Column>
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>Institute}" />
							</header>
						</Column>
						<Column visible="true">
							<header>
								<ObjectIdentifier title="{i18n>Product}" />
							</header>
						</Column>
						<Column visible="true">
							<header>
								<ObjectIdentifier title="{i18n>Price}" />
							</header>
						</Column>
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>effectiveDate}" />
							</header>
						</Column>
						<Column>
							<header>
								<ObjectIdentifier title="{i18n>expiryDate}" />
							</header>
						</Column>
					</columns>
					<items>
					<!-- EHQUT-Spain - visual mark to notify that the offer is canceled in FAST -->
						<ColumnListItem type="Navigation" press=".onSelectionChange" highlight="{= ${Synchronized} === true ? 'None' : 'Warning'}" id="items">
						<customData> <core:CustomData key="mydata" value="{Status}{CountryCode}" writeToDom='true'></core:CustomData><core:CustomData key="mydata1" value="{Expired}{isCancelled}" writeToDom='true'></core:CustomData></customData>
							<cells>
								<VBox>
									<Text text="{OfferId}"/>
									<Text text="{Tender/ExternalID}"/>
									<Text text="{Tender/SAPID}"/>
								</VBox>
                                <!-- EHQUT-175601-Customer Code added in price agreement -->
                                <!-- <Text text="{OfferId}"/> -->
								<Text text="{Tender/User/UserName}"/>
								<Text text="{Tender/Classification}"/>
								<Text text="{Tender/TenderName}"/>
                                <Text text="{MaterialsList}"/>
                                <Text text="{Institute/CustomerID}"/>
                                <Text text="{OfferProduct/Offer/Division}"/>
								<Text text="{Institute/InstituteName}"/>
								<Text text="{Product/ProductPack/PRODUCTPACKNAME}"/>
								<Text text="{Price}"/>
								<Text text="{
										path: 'EffectiveDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
								<Text text="{
										path: 'ExpiryDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>

</mvc:View>