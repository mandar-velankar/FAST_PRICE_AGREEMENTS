<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<ViewSettingsDialog
		id="viewSettingsDialog"
		confirm=".onConfirmViewSettingsDialog">
		<sortItems>
			<ViewSettingsItem
				text="{i18n>masterSort1}"
				key="Tender/TenderName"
				selected="true"/>
			<ViewSettingsItem
				text="{i18n>masterSort2}"
				key="Product/ProductPack/PRODUCTPACKNAME"
				selected="true"/>
			<ViewSettingsItem
				text="{i18n>masterSort3}"
				key="ExpiryDate"
				selected="true"/>
			<ViewSettingsItem
				text="{i18n>masterSort4}"
				key="EffectiveDate"
				selected="true"/>
			<ViewSettingsItem
				text="{i18n>Classification}"
				key="Tender/Classification"
				selected="true"/>
			<ViewSettingsItem
				text="{i18n>Institute}"
				key="Institute/InstituteName"
				selected="true"/>
		</sortItems>

	</ViewSettingsDialog>
</core:FragmentDefinition>