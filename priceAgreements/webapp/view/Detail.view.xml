<mvc:View
	controllerName="com.bayer.tender.priceagreements.controller.Detail"
	xmlns="sap.uxap" 
	xmlns:m="sap.m" 
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" 
	xmlns:mvc="sap.ui.core.mvc" 
	xmlns:t="sap.ui.table" 
	xmlns:core="sap.ui.core" 
	xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" 
	xmlns:viz="sap.viz.ui5.controls" 
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:tnt="sap.tnt">

	<!-- ObjectPage Layout -->
	<ObjectPageLayout showFooter="{pa>/editMode}" id="DetailPage">

	<headerTitle>
			<ObjectPageDynamicHeaderTitle>
				
				<!-- Heading part that is used when heading is not collapsed -->
				<expandedHeading>
					<m:Title text="{pa>/priceAgreement/tender/tenderName} / {pa>/priceAgreement/institute/instituteName} / {pa>/priceAgreement/product/productPack/pRODUCTPACKNAME}" id="tenderId" wrapping="true" class="sapUiSmallMarginEnd"/>
				</expandedHeading>

				<!-- WINDOW ACTIONS -->
				<navigationActions>
					<m:OverflowToolbarButton id="enterFullScreenButton" type="Transparent" icon="sap-icon://full-screen" press=".toggleFullScreen"
						tooltip="Enter Full Screen Mode" visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}" />
					<m:OverflowToolbarButton id="exitFullScreenButton" type="Transparent" icon="sap-icon://exit-full-screen" press=".toggleFullScreen"
						tooltip="Exit Full Screen Mode" visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}"/>
					<m:OverflowToolbarButton id="closeScreenButton" type="Transparent" icon="sap-icon://decline" press=".onCloseDetailPress" tooltip="Close column"
						visible="true"/>
				</navigationActions>
				
				<!-- ACTIONS -->
				<actions>
					<m:Button id="syncrButtonId" icon="sap-icon://synchronize" text="Synchronize" type="Emphasized" press=".onSynchronize" enabled="{= !${pa>/priceAgreement/synchronized} &amp;&amp; 
																																					${pa>/priceAgreement/customerPrices}.length > 0 
																																					}"/>
					<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditModePress" enabled="{= ${pa>/editMode} === false }"/>
				</actions>
				
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>

		<headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
			  <m:MessageStrip
				text="Your changes have not yet been synchronized."
				type="Warning"
				showIcon="true"
				showCloseButton="false"
				class="sapUiSmallMarginBottom" 
				visible="{= !${pa>/priceAgreement/synchronized}}">
			  </m:MessageStrip>
				
			</m:FlexBox>
		</headerContent>

		<sections>

		    <ObjectPageSection showTitle="false" visible="true">
					<ObjectPageSubSection mode="Expanded" title="Price Agreement Details">
                    <m:VBox>   
                    <m:Text text="{detailView>/selectedProductUoM}"/>
						<m:RadioButtonGroup id="rbgUoM" columns="2" selectedIndex="{= ${detailView>/selectedProductUoM} === 'Pack' ? 0 : 1}" select=".onRbgUoMChange">
						    <m:RadioButton id="rbgPack" text="Pack" />
						    <m:RadioButton id="rbgUnit" text="Unit" />
					    </m:RadioButtonGroup>
                        <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="5" labelSpanM="12" labelSpanS="12"
										adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="1" columnsXL="2" columnsL="2" columnsM="2"
										singleContainerFullSize="false" backgroundDesign="Solid" id="opportunityDetailsFormId">
							<form:content>
								<core:Title text=""/>
								<m:Label text="{i18n>effectiveDate}" design="Bold"  required="false"/>
								<m:Input value="{path: 'pa>/priceAgreement/effectiveDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd',
											UTC:true
										}}"  enabled="false"/>

								<m:Label text="{i18n>expiryDate}" design="Bold"  required="true"/>
								<m:DatePicker id="expiryDateID" value="{path: 'pa>/priceAgreement/expiryDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd',
											UTC:true
										}}" 
										valueFormat="yyyy-MM-dd"
										change=".handleDateChange"
										valueState="{pa>/priceAgreement/expiryDateValueState}" enabled="{pa>/editMode}"/>

								<m:Label text="{i18n>listPrice}" design="Bold" required="false"/>
								<m:Input value="{pa>/priceAgreement/listPrice} "  description="EUR" enabled="false" />

								<m:Label text="{i18n>RetailPrice}" design="Bold" required="false"/>
								<m:Input value="{pa>/priceAgreement/retailPrice}" description="EUR" enabled="false" />

								<m:Label text="{i18n>Discount}" design="Bold" required="false"/>
								<m:Input value="{pa>/priceAgreement/discount}"  enabled="false"/>

								<m:Label text="{i18n>price}" design="Bold" required="false"/>
								<m:Input value="{pa>/priceAgreement/price} " description="EUR"  enabled="false"/>

								<core:Title text=""/>
								<m:Label text="{i18n>awardedVol}" design="Bold" required="false"/>
								<m:Input value="{pa>/priceAgreement/awardedVolume}" description="Units"  enabled="false"/>

								<m:Label text="{i18n>deliveredVol}" design="Bold" required="false"/>
								<m:Input value="{pa>/priceAgreement/deliveredVolume}" description="Units" enabled="false"/>

								<m:Label text="{i18n>Residue}" design="Bold" required="false"/>
								<m:Input value="{= Math.round(100 * (1 - (${pa>/priceAgreement/deliveredVolume}/${pa>/priceAgreement/awardedVolume}))) }" enabled="false" description="%"/>

							</form:content>
					</form:SimpleForm>
                    </m:VBox>     
					</ObjectPageSubSection>

					<ObjectPageSubSection mode="Expanded">
							<m:IconTabBar>
							<m:items>
								<m:IconTabFilter text="Customer Prices" key="customerPrices">
									<m:Table id="MaterialsTableID" 
										mode="SingleSelectMaster"
										delete="onDeleteProduct"
										selectionChange=".onProductItemSelect"
										items="{pa>/priceAgreement/candidatePrices}"
									>
										<m:headerToolbar>
											<m:OverflowToolbar>
												<m:content>
													<m:Label text="{i18n>materialNo}" />
													<m:Select  
														id="idMaterialNumberSelect"
														change=".onMaterialNumberChange" 
														items="{ 
															path: 'pa>/priceAgreement/materials'
														}">
														<core:Item key="{pa>sKUCode}" text="{pa>sKUCode}" />
													</m:Select>
												</m:content>
											</m:OverflowToolbar>
										</m:headerToolbar>
										<m:columns>
											<m:Column minScreenWidth="Desktop" demandPopin="true" width="150px" popinDisplay="Inline">
												<m:Label text="Institute" wrapping="true"/>
											</m:Column>
											<m:Column minScreenWidth="Desktop" demandPopin="true" width="150px" popinDisplay="Inline">
												<m:Label text="Material No." wrapping="true"/>
											</m:Column>
											<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
												<m:Label text="Apply" wrapping="true"/>
											</m:Column>
											<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
												<m:Label text="Price" wrapping="true"/>
											</m:Column>
											<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
												<m:Label text="Effective Date" wrapping="true"/>
											</m:Column>
											<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
												<m:Label text="Expiry Date" wrapping="true"/>
											</m:Column>
										</m:columns>
										<m:items>
											<m:ColumnListItem highlight="Indication04">
												<m:cells>
													<m:Text text="{pa>instituteName}"/>
													<m:Text text="{pa>materialNumber}"/>
													<m:Switch state="{pa>applied}" customTextOn="Yes" customTextOff="No" enabled="{= ${pa>/editMode} &amp;&amp; !${pa>applied} }">
														<m:layoutData>
															<m:FlexItemData growFactor="1" />
														</m:layoutData>
													</m:Switch>
													<m:Text text="{pa>price}"/> 
													<m:Text text="{
															path: 'pa>effectiveDate',
															type: 'sap.ui.model.type.Date',
															formatOptions: {
																pattern: 'yyyy-MM-dd',
																UTC:true
															}
														}" 
													/>
													<m:Text text="{
															path: 'pa>expiryDate',
															type: 'sap.ui.model.type.Date',
															formatOptions: {
																pattern: 'yyyy-MM-dd',
																UTC:true
															}
														}" 
													/>
												</m:cells>
											</m:ColumnListItem>
										</m:items>
									</m:Table>
								</m:IconTabFilter>
								<m:IconTabFilter text="Deliveries" key="deliveries">
									<m:Table id="DeliveriesTableID" 
										mode="SingleSelectMaster"
										delete="onDeleteDelivery"
										selectionChange=".onDeliveryPress"
										items="{pa>/priceAgreement/Deliveries}"
									>
										<m:columns>
											<m:Column >
												<m:Label text="Institute Name" wrapping="true"/>
											</m:Column>
											<m:Column >
												<m:Label text="Date" wrapping="true"/>
											</m:Column>
											<m:Column >
												<m:Label text="Quantity" wrapping="true"/>
											</m:Column>
											<m:Column >
												<m:Label text="UoM" wrapping="true"/>
											</m:Column>
										</m:columns>
										<m:items>
											<m:ColumnListItem press="onDeliveryPress" detailPress="onDeliveryPress">
												<m:cells>
													<m:Text text="{pa>InstituteName}"/>
													<m:Text text="{
															path: 'pa>WADAT_IST',
															type: 'sap.ui.model.type.Date',
															formatOptions: {
																pattern: 'yyyy-MM-dd',
																UTC:true
															}
														}" 
													/>
													<m:Text text="{pa>ANZPK}"/>
													<m:Text text="{pa>VRKME}"/> 
													
												</m:cells>
											</m:ColumnListItem>
										</m:items>
									</m:Table>
								</m:IconTabFilter>
								<m:IconTabFilter text="FOC" key="foc">
									<m:Table id="idFocTable" 
										mode="SingleSelectMaster"
										selectionChange=".onFocItemSelect"
										items="{pa>/priceAgreement/FOC}"
									>
										<m:columns>
											<m:Column minScreenWidth="Desktop" demandPopin="true" width="150px" popinDisplay="Inline">
												<m:Label text="Product" wrapping="true"/>
											</m:Column>
											<m:Column minScreenWidth="Desktop" demandPopin="true" width="150px" popinDisplay="Inline">
												<m:Label text="FOC" wrapping="true"/>
											</m:Column>
											<m:Column minScreenWidth="Desktop" demandPopin="true" width="150px" popinDisplay="Inline">
												<m:Label text="FOC Step" wrapping="true"/>
											</m:Column>
										</m:columns>
										<m:items>
											<m:ColumnListItem>
												<m:cells>
													<m:Text text="{pa>ProductPackName}"/>
													<m:Text text="{= ${pa>FreeGoods_ABS_PCT} === 'PCT' ? ${pa>FreeGoods} * 100 : ${pa>FreeGoods}} {= ${pa>FreeGoods_ABS_PCT} === 'PCT' ? '%' : 'units'}"/>
													<m:Text text="{= ${pa>FreeGoods_Step} === '0' ? '' : ${pa>FreeGoods_Step} + ' units' }"/>
												</m:cells>
											</m:ColumnListItem>
										</m:items>
									</m:Table>
								</m:IconTabFilter>
							</m:items>
						</m:IconTabBar>
					</ObjectPageSubSection>

			</ObjectPageSection>

		</sections>

		<!-- footer bar-->
		<footer>
			<m:OverflowToolbar>
				<m:ToolbarSpacer />
				<m:Button type="Accept" text="Save" press="onFooterSavePress"/>
				<m:Button type="Reject" text="Cancel" press="onFooterCancelPress"/>
			</m:OverflowToolbar>
		</footer>
	</ObjectPageLayout>
</mvc:View>