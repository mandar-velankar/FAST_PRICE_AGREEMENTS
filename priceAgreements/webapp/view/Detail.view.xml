<mvc:View
	controllerName="com.bayer.tender.priceagreements.controller.Detail"
	xmlns="sap.uxap" 
	xmlns:m="sap.m" 
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" 
	xmlns:mvc="sap.ui.core.mvc" 
	xmlns:t="sap.ui.table" 
	xmlns:core="sap.ui.core" 
	xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" 
	xmlns:viz="sap.viz.ui5.controls" 
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:tnt="sap.tnt">

	<!-- ObjectPage Layout -->
	<ObjectPageLayout showFooter="{pa>/editMode}" id="DetailPage">

	<headerTitle>
			<ObjectPageDynamicHeaderTitle>
				
				<!-- Heading part that is used when heading is not collapsed -->
				<expandedHeading>
					<m:Title text="{pa>/priceAgreement/tender/tenderName} / {pa>/priceAgreement/institute/instituteName} / {pa>/priceAgreement/product/productPack/pRODUCTPACKNAME}" id="tenderId" wrapping="true" class="sapUiSmallMarginEnd"/>
				</expandedHeading>

				<!-- WINDOW ACTIONS -->
				<navigationActions>
					<m:OverflowToolbarButton id="enterFullScreenButton" type="Transparent" icon="sap-icon://full-screen" press=".toggleFullScreen"
						tooltip="Enter Full Screen Mode" visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}" />
					<m:OverflowToolbarButton id="exitFullScreenButton" type="Transparent" icon="sap-icon://exit-full-screen" press=".toggleFullScreen"
						tooltip="Exit Full Screen Mode" visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}"/>
					<m:OverflowToolbarButton id="closeScreenButton" type="Transparent" icon="sap-icon://decline" press=".onCloseDetailPress" tooltip="Close column"
						visible="true"/>
				</navigationActions>
				
				<!-- ACTIONS -->
				<actions>
                    <m:Button 
						id="toOfferButtonId"
						text="To Offer" 
						type="Emphasized" 
						press=".onNavigateToOffer" 
						enabled="true"
                        visible="true"
					/>

                    <m:Button 
						id="ignorePVLPriceChangeButtonId"
						text="Ignore PVL Price Change" 
						type="Emphasized" 
						press=".onIgnorePVLPriceChange" 
						enabled="true"
                        visible="{= ${pa>/priceAgreement/countryCode} === 'ES' &amp;&amp; ${pa>/priceAgreement/hasNewYLLP} === 1 &amp;&amp; !${pa>/editMode}}"
					/>

                    <m:Button 
						id="ignoreConfPriceChangeButtonId"
						text="Ignore Confidential Price Change" 
						type="Emphasized" 
						press=".onIgnoreConfPriceChange" 
						enabled="true"
                        visible="{= ${pa>/priceAgreement/countryCode} === 'ES' &amp;&amp; ${pa>/priceAgreement/hasNewYLAP} === 1 &amp;&amp; !${pa>/editMode}}"
					/>

                    <m:Button 
						id="terminateButtonId" 
						icon="sap-icon://cancel" 
						text="Terminate" 
						type="Emphasized" 
						press=".onCancelPriceAgreement" 
						enabled="{= ${pa>/priceAgreement/status} !== 'Cancelled'}"
                        visible="{= ${pa>/priceAgreement/countryCode} === 'ES' }"
					/>
					<m:Button 
						id="syncrButtonId" 
						icon="sap-icon://synchronize" 
						text="Synchronize" 
						type="Emphasized" 
						press=".onSynchronize" 
						enabled="{ 
								parts: [ 
									'pa>/priceAgreement/synchronized', 
									'pa>/priceAgreement/customerPrices',
                                    'pa>/priceAgreement/status',
                                    'pa>/priceAgreement/synchronizationStatus'
								], 
								formatter: '.isSyncButtonEnabled' 
						}"
					/>
					<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditModePress" enabled="{= ${pa>/editMode} === false &amp;&amp; !(${pa>/priceAgreement/status} === 'Cancelled') &amp;&amp; !(${pa>/priceAgreement/synchronizationStatus} === 'RUNNING') }"/>
				</actions>
				
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>

		<headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
			  <m:MessageStrip
				text="Synchronization of this Price Agreement is running"
				type="Warning"
				showIcon="true"
				showCloseButton="false"
				class="sapUiSmallMarginBottom" 
				visible="{= ${pa>/priceAgreement/synchronizationStatus} === 'RUNNING'}">
			  </m:MessageStrip>
			  <m:MessageStrip
				text="Synchronization of this Price Agreement has failed."
				type="Error"
				showIcon="true"
				showCloseButton="false"
				class="sapUiSmallMarginBottom" 
				visible="{= ${pa>/priceAgreement/synchronizationStatus} === 'ERROR'}">
			  </m:MessageStrip>
			  <m:MessageStrip
				text="Your changes have not yet been synchronized."
				type="Warning"
				showIcon="true"
				showCloseButton="false"
				class="sapUiSmallMarginBottom" 
				visible="{= !${pa>/priceAgreement/synchronized} &amp;&amp; ${pa>/priceAgreement/synchronizationStatus} !== 'RUNNING' &amp;&amp; ${pa>/priceAgreement/synchronizationStatus} !== 'ERROR'}">
			  </m:MessageStrip>
				
			</m:FlexBox>
            <m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
			  <m:MessageStrip
				text="Net Price is above PVL."
				type="Warning"
				showIcon="true"
				showCloseButton="false"
				class="sapUiSmallMarginBottom" 
				visible="{= ${pa>/priceAgreement/countryCode} === 'ES' &amp;&amp; ${pa>/priceAgreement/hasNewYLLP} === 3}">
			  </m:MessageStrip>

			  <m:MessageStrip
				text="Net Price is above Confidential Price."
				type="Warning"
				showIcon="true"
				showCloseButton="false"
				class="sapUiSmallMarginBottom" 
				visible="{= ${pa>/priceAgreement/countryCode} === 'ES' &amp;&amp; ${pa>/priceAgreement/hasNewYLAP} === 3}">
			  </m:MessageStrip>

              <m:MessageStrip
				text="Net Price is below Floor Price."
				type="Warning"
				showIcon="true"
				showCloseButton="false"
				class="sapUiSmallMarginBottom" 
				visible="{= ${pa>/priceAgreement/countryCode} === 'ES' &amp;&amp; ${pa>/priceAgreement/hasNewYLLP} === 4}">
			  </m:MessageStrip>

              <m:MessageStrip
				text="Net Price is below Floor Price."
				type="Warning"
				showIcon="true"
				showCloseButton="false"
				class="sapUiSmallMarginBottom" 
				visible="{= ${pa>/priceAgreement/countryCode} === 'ES' &amp;&amp; ${pa>/priceAgreement/hasNewYLAP} === 4}">
			  </m:MessageStrip>
			</m:FlexBox>
		</headerContent>

		<sections>
			<!-- Country-specific Detail fragments are dynamically loaded from the controller. See .addCountryDetailFragments -->
		</sections>

		<!-- footer bar-->
		<footer>
			<m:OverflowToolbar>
				<m:ToolbarSpacer />
				<m:Button type="Accept" text="Save" press="onFooterSavePress"/>
				<m:Button type="Reject" text="Cancel" press="onFooterCancelPress"/>
			</m:OverflowToolbar>
		</footer>
	</ObjectPageLayout>
</mvc:View>