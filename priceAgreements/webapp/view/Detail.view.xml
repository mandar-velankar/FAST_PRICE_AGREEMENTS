<mvc:View
	controllerName="com.bayer.tender.priceagreements.controller.Detail"
	xmlns="sap.uxap" 
	xmlns:m="sap.m" 
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form" 
	xmlns:mvc="sap.ui.core.mvc" 
	xmlns:t="sap.ui.table" 
	xmlns:core="sap.ui.core" 
	xmlns:l="sap.ui.layout"
	xmlns:viz.data="sap.viz.ui5.data" 
	xmlns:viz="sap.viz.ui5.controls" 
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:tnt="sap.tnt">

	<!-- ObjectPage Layout -->
	<ObjectPageLayout>

	<headerTitle>
			<ObjectPageDynamicHeaderTitle>
				
				<!-- Heading part that is used when heading is not collapsed -->
				<expandedHeading>
					<m:Title text="{pa>/priceAgreement/iD} / {pa>/priceAgreement/tender/tenderName} / {pa>/priceAgreement/institute/instituteName}" id="tenderId" wrapping="true" class="sapUiSmallMarginEnd"/>
				</expandedHeading>

				<!-- WINDOW ACTIONS -->
				<navigationActions>
					<m:OverflowToolbarButton id="enterFullScreenButton" type="Transparent" icon="sap-icon://full-screen" press=".toggleFullScreen"
						tooltip="Enter Full Screen Mode" visible="{= !${device>/system/phone} &amp;&amp; !${appView>/actionButtonsInfo/midColumn/fullScreen}}" />
					<m:OverflowToolbarButton id="exitFullScreenButton" type="Transparent" icon="sap-icon://exit-full-screen" press=".toggleFullScreen"
						tooltip="Exit Full Screen Mode" visible="{= !${device>/system/phone} &amp;&amp; ${appView>/actionButtonsInfo/midColumn/fullScreen}}"/>
					<m:OverflowToolbarButton id="closeScreenButton" type="Transparent" icon="sap-icon://decline" press=".onCloseDetailPress" tooltip="Close column"
						visible="true"/>
				</navigationActions>
				
				<!-- ACTIONS -->
				<actions>
					<m:Button id="syncrButtonId" icon="sap-icon://synchronize" text="Synchronize" type="Emphasized" press="._onSynchronize"  visible="{= !${soa>/creationMode} }"/>
					<m:Button id="editButtonId" text="Edit" type="Emphasized" press=".onEditModePress" enabled="{= ${soa>/editMode} === false ? true : false }"/>
				</actions>
				
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>

		<headerContent>
			<m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
			  <m:MessageStrip
				text="Your changes have not yet been synchronized."
				type="Warning"
				showIcon="true"
				showCloseButton="false"
				class="sapUiSmallMarginBottom">
			  </m:MessageStrip>
				
			</m:FlexBox>
		</headerContent>

		<sections>

		    <ObjectPageSection showTitle="false" visible="true">
					<ObjectPageSubSection mode="Expanded" title="Price Agreement Details">
						<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="5" labelSpanM="12" labelSpanS="12"
										adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="1" emptySpanS="1" columnsXL="2" columnsL="2" columnsM="2"
										singleContainerFullSize="false" backgroundDesign="Solid" id="opportunityDetailsFormId">
							<form:content>
								<core:Title text=""/>
								<m:Label text="{i18n>effectiveDate}" design="Bold"  required="true"/>
								<!-- <m:Input value="{soa>/selectedOpportunity/tenderReference}"  enabled="{= ${soa>/editMode} }"/> -->
								<m:Input value="{path: 'pa>/priceAgreement/effectiveDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}}"  enabled="false"/>

								<m:Label text="{i18n>expiryDate}" design="Bold"  required="true"/>
								<!-- <m:Input value="{soa>/selectedOpportunity/tenderReference}"  enabled="{= ${soa>/editMode} }"/> -->
								<m:Input value="{path: 'pa>/priceAgreement/expiryDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}}"  enabled="false"/>

								<m:Label text="{i18n>materialNo}" design="Bold" required="true"/>
								<!-- <m:Select selectedKey="{soa>/selectedOpportunity/classification}"  enabled="{= ${soa>/editMode} }" change="onClassificationChange" items="{ path: 'soa>/CountryClassifications'}">
									<core:Item text="{soa>CLASSIFICATION}" key="{soa>CLASSIFICATION}"/>
								</m:Select> -->
								<m:Select selectedKey="{pa>/priceAgreement/materialNo}">
									<core:Item text="1265465" key="1265465"/>
									<core:Item text="6565656" key="6565656"/>
								</m:Select>

								<m:Label text="{i18n>price}" design="Bold" required="true"/>
								<!-- <m:Input value="{soa>/selectedOpportunity/tenderReference}"  enabled="{= ${soa>/editMode} }"/> -->
								<m:Input value="12" description="{pa>/priceAgreement/price} EUR"  enabled="false"/>

								<m:Label text="{i18n>listPrice}" design="Bold" required="true"/>
								<!-- <m:Input value="{soa>/selectedOpportunity/tenderReference}"  enabled="{= ${soa>/editMode} }"/> -->
								<m:Input value="12"  description="{pa>/priceAgreement/listPrice} EUR" enabled="false"/>

								<m:Label text="{i18n>RetailPrice}" design="Bold" required="true"/>
								<!-- <m:Input value="{soa>/selectedOpportunity/tenderReference}"  enabled="{= ${soa>/editMode} }"/> -->
								<m:Input value="12"  enabled="false" description="{pa>/priceAgreement/retailPrice} EUR"/>

								<m:Label text="{i18n>Discount}" design="Bold" required="true"/>
								<!-- <m:Input value="{soa>/selectedOpportunity/tenderReference}"  enabled="{= ${soa>/editMode} }"/> -->
								<m:Input value="{pa>/priceAgreement/discount}"  enabled="false"/>

								<core:Title text=""/>
								<m:Label text="{i18n>requestedVol}" design="Bold" required="true"/>
								<!-- <m:Input value="{soa>/selectedOpportunity/tenderReference}"  enabled="{= ${soa>/editMode} }"/> -->
								<m:Input value="{pa>/priceAgreement/retailPrice}" description="Units"  enabled="false"/>

								<m:Label text="{i18n>deliveredVol}" design="Bold" required="true"/>
								<!-- <m:Input value="{soa>/selectedOpportunity/tenderReference}"  enabled="{= ${soa>/editMode} }"/> -->
								<m:Input value="{pa>/priceAgreement/deliveredVolume}" description="Units" enabled="false"/>

								<m:Label text="{i18n>Residue}" design="Bold" required="true"/>
								<!-- <m:Input value="{soa>/selectedOpportunity/tenderReference}"  enabled="{= ${soa>/editMode} }"/> -->
								<m:Input value="10%"  enabled="false"/>
								

							</form:content>
					</form:SimpleForm>
					</ObjectPageSubSection>

					<ObjectPageSubSection mode="Expanded" title="Customer Prices">
							<m:Table id="MaterialsTableID" 
										mode="SingleSelectMaster"
										delete="onDeleteProduct"
										selectionChange=".onProductItemSelect"
										items="{pa>/priceAgreement/customerPrices}"
							>
								<m:columns>
									<m:Column minScreenWidth="Desktop" demandPopin="true" width="150px" popinDisplay="Inline">
										<m:Label text="Institutes" wrapping="true"/>
									</m:Column>
									<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
										<m:Label text="Apply" wrapping="true"/>
									</m:Column>
									<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
										<m:Label text="Price" wrapping="true"/>
									</m:Column>
									<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
										<m:Label text="Effective Date" wrapping="true"/>
									</m:Column>
									<m:Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
										<m:Label text="Expiry Date" wrapping="true"/>
									</m:Column>
								</m:columns>
								<m:items>
									<m:ColumnListItem highlight="Indication04">
										<m:cells>
											<m:Text text="{pa>material/description}"/>
											<m:Text text="{pa>synchronized}"/>
											<m:Text text="{pa>price}"/> 
											<m:Text text="{pa>validFrom}"/> 
											<m:Text text="{pa>validTo}"/>
										</m:cells>
									</m:ColumnListItem>
								</m:items>
							</m:Table>
					</ObjectPageSubSection>
			</ObjectPageSection>

		</sections>

		<!-- footer bar-->
		<footer>
			<m:OverflowToolbar>
				<m:ToolbarSpacer />
				<m:Button type="Accept" text="Save" press="onFooterSavePress"/>
				<m:Button type="Reject" text="Cancel" press="onFooterCancelPress"/>
			</m:OverflowToolbar>
		</footer>
	</ObjectPageLayout>
</mvc:View>